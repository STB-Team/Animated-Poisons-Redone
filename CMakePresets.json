{
  "version": 2,
  "configurePresets": [
    {
      "name": "cmake-dev",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "STRING",
          "value": "Release"
        }
      },
      "errors": {
        "deprecated": true
      },
      "warnings": {
        "deprecated": true,
        "dev": true
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": {
          "type": "STRING",
          "value": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows-static"
        }
      }
    },
    {
      "name": "vs2022-windows-vcpkg",
      "inherits": [
        "cmake-dev",
        "vcpkg",
        "windows"
      ],
      "generator": "Visual Studio 17 2022",
      "toolset": "v143",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP $penv{CXXFLAGS}"
      }
    },
    {
      "name": "vs2026-windows-vcpkg",
      "inherits": [
        "cmake-dev",
        "vcpkg",
        "windows"
      ],
      "generator": "Visual Studio 18 2026",
      "toolset": "v143",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP $penv{CXXFLAGS}"
      }
    },
    {
      "name": "default",
      "inherits": [
        "vs2022-windows-vcpkg"
      ]
    },
    {
      "name": "default-2026",
      "inherits": [
        "vs2026-windows-vcpkg"
      ]
    }
  ]
}
