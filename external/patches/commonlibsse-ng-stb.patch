+	// STB: format 5 is a dense RVA table indexed by id. It is converted into the same sorted
+	// (id, offset) array as formats 1/2, so id2offset and Offset2ID work unchanged. The mapping name
+	// differs from v2 so a plugin with an older CommonLib never reads this layout as its own.
+	bool IDDatabase::load_v5(istream_t& a_in, header_t a_header, Version a_version, bool a_failOnError)
+	{
+		std::vector<std::uint32_t> table(a_header.address_count());
+		a_in.read_bytes(table.data(), table.size() * sizeof(std::uint32_t));  // short file throws (failbit)
+		const auto present = static_cast<std::size_t>(std::count_if(table.begin(), table.end(), [](auto a_rva) { return a_rva != 0; }));
+
+		auto mapname = L"CommonLibSSEOffsets-v5sparse-"s;
+		mapname += a_version.wstring();
+		const auto byteSize = present * sizeof(mapping_t);
+		if (_mmap.open(mapname, byteSize)) {
+			_id2offset = { static_cast<mapping_t*>(_mmap.data()), present };
+		} else if (_mmap.create(mapname, byteSize)) {
+			_id2offset = { static_cast<mapping_t*>(_mmap.data()), present };
+			std::size_t i = 0;
+			for (std::size_t id = 0; id < table.size(); ++id) {
+				if (table[id]) {
+					_id2offset[i++] = { static_cast<std::uint64_t>(id), static_cast<std::uint64_t>(table[id]) };
+				}
+			}
+		} else {
+			return stl::report_and_error("failed to create shared mapping"sv, a_failOnError);
+		}
+		return true;
+	}
